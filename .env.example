# Copy to .env and fill in. Without a key the app still works and serves curated ideas.
GEMINI_API_KEY=
# ANTHROPIC_API_KEY=

# MongoDB — required for the MERN stack server (server.js)
MONGODB_URI=mongodb://127.0.0.1:27017/event-planner

# JWT — change this to a strong random secret in production
JWT_SECRET=change-me-to-a-random-secret
JWT_EXPIRES_IN=7d

# Optional overrides
# GEMINI_MODEL=gemini-2.5-flash
# ANTHROPIC_MODEL=claude-opus-5-5
# PORT=3000
# HOST=127.0.0.1
# RATE_LIMIT_PER_MINUTE=20
# Only behind a reverse proxy that appends X-Forwarded-For:
# TRUST_PROXY=true
